cat > backend/app/agents/cleangeniusagent.py << 'EOLANG'
import os, uuid, json
from typing import TypedDict, List, Dict, Any
from langgraph.graph import StateGraph, END
from langchain_openai import ChatOpenAI
from langchain.schema import HumanMessage
from ..ml.pricing_inference import predict_price
from ..core.security import sign_booking

class AgentState(TypedDict):
    messages: List[Dict[str, str]]
    intent: str
    extracted_features: Dict[str, Any]
    price_quote: Dict[str, Any]
    compliance_flags: List[str]
    risk_score: float
    nudge: str
    final_response: str
    audit_id: str

llm = ChatOpenAI(model="gpt-4o-mini", temperature=0.1)

def intent_classifier(state: AgentState):
    user_text = state["messages"][-1]["content"]
    # Mock LLM extraction to ensure local runnable without API key
    state["intent"] = "booking_new"
    state["extracted_features"] = {"bedrooms": 3, "bathrooms": 2, "has_oven": True, "has_windows": False, "is_ndis": True, "distance_km": 5.0}
    return state

def price_engine_node(state: AgentState):
    feat = state["extracted_features"]
    amount = predict_price(**feat)
    state["price_quote"] = {"amount": round(amount, 2), "currency": "AUD", "quantum_signature": sign_booking(feat)}
    return state

def compliance_node(state: AgentState):
    state["compliance_flags"] = ["ndis_context"] if state["extracted_features"].get("is_ndis") else []
    return state

def neo4j_audit_node(state: AgentState):
    state["audit_id"] = str(uuid.uuid4())
    state["risk_score"] = 0.1
    return state

def response_node(state: AgentState):
    price = state["price_quote"]["amount"]
    audit = state["audit_id"]
    state["final_response"] = f"Based on your request, the estimated cost is ${price} AUD. We've applied NDIS compliance rules. (Audit ID: {audit})"
    return state

def build_graph():
    graph = StateGraph(AgentState)
    graph.add_node("intent", intent_classifier)
    graph.add_node("price", price_engine_node)
    graph.add_node("compliance", compliance_node)
    graph.add_node("audit", neo4j_audit_node)
    graph.add_node("response", response_node)
    
    graph.set_entry_point("intent")
    graph.add_edge("intent", "price")
    graph.add_edge("price", "compliance")
    graph.add_edge("compliance", "audit")
    graph.add_edge("audit", "response")
    graph.add_edge("response", END)
    return graph.compile()

clean_genius_graph = build_graph()
EOLANG

